# Local connection strings. scripts/db.sh copies this to .env on first run.
# One <NAME>_DATABASE_URL per database under database/ (make db-new adds them).
# Other environments use the same names: .env.<env> locally (make db-new-env),
# or secrets on the matching GitHub Environment in CI.

# Optional: Postgres major version for the local and scratch containers (default 16).
# POSTGRES_VERSION=16
